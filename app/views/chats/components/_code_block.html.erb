<div class="max-w-2xl" data-controller="code-block">
  <% if local_assigns[:explanation].present? %>
    <p class="text-sm text-gray-700 mb-2 leading-relaxed"><%= explanation %></p>
  <% end %>
  <div class="relative rounded-xl overflow-hidden border border-gray-700">
    <div class="flex items-center justify-between bg-gray-800 px-4 py-2">
      <span class="text-xs text-gray-400 font-mono"><%= language %></span>
      <button data-code-block-target="copyButton"
              data-action="click->code-block#copy"
              class="text-xs text-gray-400 hover:text-white transition">
        Copy
      </button>
    </div>
    <pre class="!m-0 !rounded-none overflow-x-auto"><code data-code-block-target="code" class="language-<%= language %> text-sm"><%= code %></code></pre>
  </div>
</div>
