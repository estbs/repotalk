<div class="max-w-2xl overflow-x-auto rounded-xl border border-gray-200">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 border-b border-gray-200">
      <tr>
        <% headers.each do |h| %>
          <th class="px-4 py-2.5 text-left font-medium text-gray-700"><%= h %></th>
        <% end %>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100 bg-white">
      <% rows.each do |row| %>
        <tr>
          <% row.each do |cell| %>
            <td class="px-4 py-2.5 text-gray-700"><%= cell %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
