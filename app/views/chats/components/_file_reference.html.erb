<div class="bg-white rounded-2xl rounded-tl-sm border border-gray-200 px-5 py-4 max-w-2xl">
  <div class="flex items-center gap-2 mb-2">
    <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
    </svg>
    <code class="text-sm text-indigo-700 font-mono"><%= file_path %><% if local_assigns[:start_line].present? %><span class="text-gray-400">:<%= start_line %><% if local_assigns[:end_line].present? && end_line != start_line %>–<%= end_line %><% end %></span><% end %></code>
  </div>
  <p class="text-sm text-gray-700 leading-relaxed"><%= explanation %></p>
</div>
