<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "RepoTalk" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900 min-h-screen">
    <nav class="bg-white border-b border-gray-200 px-6 py-3 flex items-center gap-4">
      <%= link_to "RepoTalk", root_path, class: "text-lg font-semibold text-indigo-600 hover:text-indigo-800" %>
      <%= link_to "+ Add Repository", new_repository_path, class: "ml-auto text-sm text-white bg-indigo-600 hover:bg-indigo-700 px-4 py-1.5 rounded-md" %>
    </nav>

    <% if notice %>
      <div class="max-w-4xl mx-auto mt-4 px-6">
        <div class="bg-green-50 border border-green-200 text-green-800 rounded-md px-4 py-3 text-sm">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <main class="max-w-4xl mx-auto px-6 py-8">
      <%= yield %>
    </main>
  </body>
</html>
